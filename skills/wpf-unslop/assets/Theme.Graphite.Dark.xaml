<!--
  wpf-unslop 시작용 테마 사전 (Graphite, 어두운 테마)

  쓰는 방법
  1. 프로젝트의 Themes 폴더에 복사하고 App.xaml의 MergedDictionaries에 추가한다.
       <ResourceDictionary Source="Themes/Theme.Graphite.Dark.xaml"/>
  2. Color.Accent는 자리표시 값이다. 방향(direction)에서 정한 강조색으로 바꾼다.
  3. 글꼴을 포함했다면 Font.Ui, Font.Mono를 그 글꼴로 바꾼다.

  값의 근거는 references/tokens.md에 있다.
  unslop(Damir Sokolovsky, CC BY 4.0)을 WPF용으로 변형한 wpf-unslop의 일부.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== 색 ===== -->
    <Color x:Key="Color.Deep">#0F0F10</Color>
    <Color x:Key="Color.Window">#141415</Color>
    <Color x:Key="Color.Card">#19191B</Color>
    <Color x:Key="Color.Raised">#232325</Color>
    <Color x:Key="Color.RaisedHover">#2A2A2D</Color>
    <Color x:Key="Color.Hairline">#14EDEDED</Color>
    <Color x:Key="Color.HairlineStrong">#24EDEDED</Color>
    <Color x:Key="Color.TopHighlight">#1FFFFFFF</Color>
    <Color x:Key="Color.Text.Primary">#EDEDED</Color>
    <Color x:Key="Color.Text.Secondary">#A1A1A6</Color>
    <Color x:Key="Color.Text.Muted">#85858B</Color>
    <Color x:Key="Color.Text.OnPrimary">#141415</Color>
    <!-- 자리표시 값: 방향에서 정한 강조색으로 바꾼다 -->
    <Color x:Key="Color.Accent">#E0A040</Color>
    <Color x:Key="Color.Positive">#4CC38A</Color>
    <Color x:Key="Color.Negative">#E5484D</Color>

    <SolidColorBrush x:Key="Brush.Deep" Color="{StaticResource Color.Deep}"/>
    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}"/>
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
    <SolidColorBrush x:Key="Brush.Raised" Color="{StaticResource Color.Raised}"/>
    <SolidColorBrush x:Key="Brush.RaisedHover" Color="{StaticResource Color.RaisedHover}"/>
    <SolidColorBrush x:Key="Brush.Hairline" Color="{StaticResource Color.Hairline}"/>
    <SolidColorBrush x:Key="Brush.HairlineStrong" Color="{StaticResource Color.HairlineStrong}"/>
    <SolidColorBrush x:Key="Brush.TopHighlight" Color="{StaticResource Color.TopHighlight}"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}"/>
    <SolidColorBrush x:Key="Brush.Text.OnPrimary" Color="{StaticResource Color.Text.OnPrimary}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Positive" Color="{StaticResource Color.Positive}"/>
    <SolidColorBrush x:Key="Brush.Negative" Color="{StaticResource Color.Negative}"/>

    <!-- ===== 글꼴 ===== -->
    <FontFamily x:Key="Font.Ui">Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.Meta">12</sys:Double>
    <sys:Double x:Key="FontSize.Caption">13</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Section">16</sys:Double>
    <sys:Double x:Key="FontSize.Title">24</sys:Double>
    <sys:Double x:Key="FontSize.Figure">28</sys:Double>
    <sys:Double x:Key="FontSize.Icon">16</sys:Double>

    <!-- ===== 여백과 반경 ===== -->
    <Thickness x:Key="Space.WindowPadding">24</Thickness>
    <Thickness x:Key="Space.CardPadding">20</Thickness>
    <Thickness x:Key="Space.ControlPadding">12,0,12,0</Thickness>
    <sys:Double x:Key="Size.Row">36</sys:Double>
    <sys:Double x:Key="Size.Control">32</sys:Double>

    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">16</CornerRadius>

    <!-- ===== 움직임 ===== -->
    <Duration x:Key="Motion.Fast">0:0:0.14</Duration>
    <Duration x:Key="Motion.Menu">0:0:0.18</Duration>
    <Duration x:Key="Motion.Enter">0:0:0.36</Duration>
    <QuinticEase x:Key="Motion.Ease" EasingMode="EaseOut"/>

    <!-- ===== 텍스트 역할 ===== -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="LineHeight" Value="21"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style x:Key="Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
    </Style>
    <Style x:Key="Text.Meta" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}"/>
    </Style>
    <Style x:Key="Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Section}"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Title}"/>
        <Setter Property="LineHeight" Value="30"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="Text.Figure" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Figure}"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="Text.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Icon}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== 표면 ===== -->
    <Style x:Key="Surface.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Padding" Value="{StaticResource Space.CardPadding}"/>
    </Style>

    <!-- ===== keyboard focus 표시 =====
         Tab 키로 이동할 때만 보이고, 마우스로 누를 때는 보이지 않는다. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="8" RadiusY="8"
                               Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 버튼 =====
         상태: hover(색 변화), pressed(0.98 축소), keyboard focus(FocusRing), disabled(흐림).
         배경 brush는 템플릿 안에서 새로 만들어 animate할 수 있게 한다. -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Height" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="{StaticResource Space.ControlPadding}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform/>
            </Setter.Value>
        </Setter>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Control}"
                            BorderBrush="{StaticResource Brush.Hairline}" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource Color.Raised}"/>
                        </Border.Background>
                        <Grid>
                            <!-- 위쪽 1px 하이라이트 -->
                            <Border BorderBrush="{StaticResource Brush.TopHighlight}"
                                    BorderThickness="0,1,0,0" CornerRadius="{StaticResource Radius.Control}"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource Color.RaisedHover}"
                                                        Duration="{StaticResource Motion.Fast}"
                                                        EasingFunction="{StaticResource Motion.Ease}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        Duration="{StaticResource Motion.Fast}"
                                                        EasingFunction="{StaticResource Motion.Ease}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.OnPrimary}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource Color.Text.Primary}"/>
                        </Border.Background>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#FFFFFF"
                                                        Duration="{StaticResource Motion.Fast}"
                                                        EasingFunction="{StaticResource Motion.Ease}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        Duration="{StaticResource Motion.Fast}"
                                                        EasingFunction="{StaticResource Motion.Ease}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 툴바, 목록 안 동작: 평소 투명, hover에서 올라온 표면 -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="Padding" Value="8,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush Color="#00232325"/>
                        </Border.Background>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource Color.Raised}"
                                                        Duration="{StaticResource Motion.Fast}"
                                                        EasingFunction="{StaticResource Motion.Ease}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        Duration="{StaticResource Motion.Fast}"
                                                        EasingFunction="{StaticResource Motion.Ease}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 입력 상자 ===== -->
    <Style x:Key="Input.Text" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Raised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Hairline}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="8,0,8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.HairlineStrong}"/>
                        </Trigger>
                        <!-- 입력 상자는 마우스로 눌러도 focus 표시가 필요하다 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 얇은 스크롤바 =====
         ScrollViewer 안에서 자동 적용되도록 키 없이 정의한다. 원하지 않으면 x:Key를 붙인다. -->
    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="3" Background="{StaticResource Brush.HairlineStrong}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Text.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Text.Secondary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBar.Thumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBar.Thumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
